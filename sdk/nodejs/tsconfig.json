{
    "compilerOptions": {
        // Output
        "outDir": "bin",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "stripInternal": true,
        // Environment
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "types": ["node"],
        // Type Checking
        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "skipLibCheck": true
    },
    "files": [
        "accountToken.ts",
        "application.ts",
        "applicationSet.ts",
        "cluster.ts",
        "config/index.ts",
        "config/vars.ts",
        "getApplication.ts",
        "gpgKey.ts",
        "index.ts",
        "project.ts",
        "projectToken.ts",
        "provider.ts",
        "repository.ts",
        "repositoryCertificate.ts",
        "repositoryCredentials.ts",
        "types/index.ts",
        "types/input.ts",
        "types/output.ts",
        "utilities.ts"
    ]
}
